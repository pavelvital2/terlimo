+    def test_registration_all_variants_and_default_true(self):
+        tree = ast.parse((ROOT/'platega/service.py').read_text())
+        calls = [n for n in ast.walk(tree) if isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and n.func.id == 'LinkPaymentDescriptor']
+        self.assertEqual(len(calls), 2)
+        for n in calls:
+            guards = [k.value for k in n.keywords if k.arg == 'create_allowed']
+            self.assertEqual(len(guards), 1)
+            fn = eval(compile(ast.Expression(guards[0]), 'guard', 'eval'))
+            self.assertFalse(fn(NS(create_enabled=False)))
+            self.assertTrue(fn(NS(create_enabled=True)))
+        config = ast.parse((ROOT/'platega/config.py').read_text())
+        field = next(n for n in ast.walk(config) if isinstance(n, ast.AnnAssign) and getattr(n.target,'id','') == 'CREATE_ENABLED')
+        self.assertTrue(next(k.value.value for k in field.value.keywords if k.arg == 'default'))
