+    def test_callback_true_still_creates(self):
+        env, desc, args = self.engine(enabled=True)
+        call(load('shared/link_flow.py', 'run_callback_payment', env), *args)
+        env['payment_dal'].create_payment_record.assert_awaited_once()
+        desc.create.assert_awaited_once()
+
+    def test_webapp_false_zero_newrows(self):
+        env, desc, _ = self.engine()
+        result = call(load('shared/link_flow.py', 'run_webapp_payment', env), desc, NS(request=object()))
+        self.assertEqual(result, 'unavailable')
+        env['create_webapp_payment_record'].assert_not_awaited()
+        desc.create.assert_not_awaited()
+
+    def test_existing_webapp_reuse_survives_false(self):
+        env, desc, _ = self.engine(reuse=True)
+        env['app_optional'] = lambda *a: NS(configured=True, create_enabled=False)
+        result = call(load('shared/link_flow.py', 'run_reuse_webapp_payment', env), desc, NS(request=object()), NS(payment_id=7))
+        self.assertEqual(result, 'https://offline/existing')
+        env['create_webapp_payment_record'].assert_not_awaited()
+
+    def test_existing_status_survives_false(self):
+        class Response:
+            status = 200
+            async def __aenter__(self): return self
+            async def __aexit__(self, *a): pass
+            async def json(self, **kw): return {'status': 'PENDING'}
