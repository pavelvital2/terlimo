+"""Execute actual source functions with fake IO, without third-party imports."""
+import ast
+import asyncio
+import copy
+import logging
+import unittest
+from pathlib import Path
+from types import SimpleNamespace as NS
+from unittest.mock import AsyncMock
+
+ROOT = Path(__file__).resolve().parents[1] / 'backend/bot/payment_providers'
+
+
+def load(path, name, env, owner=None):
+    tree = ast.parse((ROOT / path).read_text())
+    nodes = tree.body
+    if owner:
+        nodes = next(n.body for n in nodes if isinstance(n, ast.ClassDef) and n.name == owner)
+    n = copy.deepcopy(next(n for n in nodes if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)) and n.name == name))
+    n.decorator_list = []
+    module = ast.Module(body=[ast.ImportFrom(module='__future__', names=[ast.alias(name='annotations')], level=0), n], type_ignores=[])
+    exec(compile(ast.fix_missing_locations(module), str(ROOT/path), 'exec'), env)
+    return env[name]
+
+
+def call(fn, *a, **kw):
+    return asyncio.run(fn(*a, **kw))
+
+
+class GateTests(unittest.TestCase):
+    def transport(self, enabled):
+        post = AsyncMock(return_value=(True, {'transactionId': 'fake'}))
+        env = {'logger': logging.getLogger('offline'), 'normalize_payment_currency_code': lambda x: x, 'parse_supported_currency_codes': lambda x: (), 'post_json_request': post}
+        fn = load('platega/service.py', 'create_transaction', env, 'PlategaService')
+        svc = NS(create_enabled=enabled, configured=True, settings=NS(DEFAULT_CURRENCY_SYMBOL='RUB'), config=NS(SUPPORTED_CURRENCIES='RUB'), _get_session=AsyncMock(return_value=object()), base_url='offline', return_url='offline/return', failed_url='offline/failed', payment_method=2, _auth_headers={})
+        return fn, svc, post
+
+    def test_direct_false_zero_post_and_session(self):
+        fn, svc, post = self.transport(False)
+        for method in [2, 11, 13, None]:
+            self.assertEqual(call(fn, svc, amount=10, currency='RUB', description='offline', payment_method=method, allow_method_selection=method is None), (False, {'message': 'creation_disabled'}))
+        post.assert_not_awaited()
+        svc._get_session.assert_not_awaited()
+
+    def test_true_compatible_post(self):
+        fn, svc, post = self.transport(True)
+        self.assertTrue(call(fn, svc, amount=10, currency='RUB', description='offline')[0])
+        self.assertEqual(post.await_args.kwargs['body']['paymentMethod'], 2)
+        post.assert_awaited_once()
+
+    def test_recurring_false_zero_create(self):
+        svc = NS(config=NS(CREATE_ENABLED=False), create_transaction=AsyncMock())
+        fn = load('platega/subscriptions.py', 'create_subscription', {'subscription_interval_for_months': lambda x: 1, 'logger': logging.getLogger('offline')}, 'PlategaSubscriptionMixin')
+        self.assertEqual(call(fn, svc, amount=10, currency='RUB', description='offline', months=1), (False, {'message': 'creation_disabled'}))
+        svc.create_transaction.assert_not_awaited()
+
+    def engine(self, reuse=False, enabled=False):
+        dal = NS(find_recent_pending_provider_payment=AsyncMock(return_value=NS(payment_id=7) if reuse else None), create_payment_record=AsyncMock(return_value=NS(payment_id=8)))
+        parts = NS(price=10, months=1, sale_mode='subscription', entitlement_context_snapshot='snapshot')
+        svc = NS(configured=True, create_enabled=enabled, subscription_service=object())
+        desc = NS(spec=NS(is_available_to_user=lambda *a, **k: True, callback_prefix='pay'), display_name='Platega', provider_key='platega', pending_status='pending_platega', callback_payment_allowed=None, callback_context=None, callback_reuse_enabled=True, callback_reuse_since_minutes=None, callback_reuse_answer=False, create_allowed=lambda s: s.create_enabled, create=AsyncMock(return_value=(True, {})), callback_before_create=None, checkout_ttl_seconds=None, callback_lead_text=None, extract_url=lambda r: None, extract_provider_id=lambda r: None, log_prefix='offline', service_app_key='platega_service', service_type=object, webapp_context=None)
+        env = {'logger': logging.getLogger('offline'), 'make_translator': lambda *a: lambda *a, **k: '', 'parse_payment_callback': lambda x: parts, 'quote_hwid_callback_parts': AsyncMock(return_value=(parts, None)), 'default_currency_key_for_settings': lambda s: 'RUB', '_resolve_callback_currency': lambda *a: 'RUB', 'describe_payment': lambda *a: 'offline', 'build_payment_record_payload': lambda **k: {}, 'payment_record_amounts': lambda **k: NS(months=1, purchased_gb=None, purchased_hwid_devices=None, tariff_key=None), 'payment_dal': dal, 'detached_payment_snapshot': lambda p: p, '_reuse_payment': AsyncMock(return_value='https://offline/existing' if reuse else None), 'notify_service_unavailable': AsyncMock(), 'render_payment_link': AsyncMock(), 'CreatePaymentRequest': lambda **k: NS(**k), 'resolve_checkout_expiration': lambda *a, **k: None, 'render_link_or_fail': AsyncMock(), 'app_required': lambda req, key, typ: svc if key == 'platega_service' else NS(), 'Settings': object, '_webapp_service_available': lambda *a: True, 'payment_unavailable': lambda: 'unavailable', 'create_webapp_payment_record': AsyncMock()}
+        cb = NS(from_user=NS(id=1), message=object(), data='cached')
+        args = (desc, cb, NS(DEFAULT_LANGUAGE='en'), {'i18n_instance': object()}, svc, NS(commit=AsyncMock(), rollback=AsyncMock()))
+        return env, desc, args
+
+    def test_cached_callback_false_zero_newrows(self):
+        env, desc, args = self.engine()
+        call(load('shared/link_flow.py', 'run_callback_payment', env), *args)
+        env['payment_dal'].create_payment_record.assert_not_awaited()
+        desc.create.assert_not_awaited()
+        env['notify_service_unavailable'].assert_awaited_once()
+
+    def test_existing_callback_reuse_survives_false(self):
+        env, desc, args = self.engine(reuse=True)
+        call(load('shared/link_flow.py', 'run_callback_payment', env), *args)
+        env['render_payment_link'].assert_awaited_once()
+        env['payment_dal'].create_payment_record.assert_not_awaited()
+        desc.create.assert_not_awaited()
