+    async def ownership_route(self, request: web.Request) -> web.Response:
+        """Internal read-only lookup; merchant authentication, no payment side effects."""
+        if not self.config.OWNERSHIP_LOOKUP_ENABLED:
+            return web.json_response({"ok": False}, status=404)
+        if not self.configured:
+            return web.json_response({"ok": False}, status=503)
+        if not (
+            constant_time_compare(request.headers.get("X-MerchantId"), self.merchant_id)
+            and constant_time_compare(request.headers.get("X-Secret"), self.secret)
+        ):
+            return web.json_response({"ok": False}, status=403)
+        transaction_id = request.query.get("transaction_id", "")
+        if not isinstance(transaction_id, str) or not transaction_id.strip() or len(transaction_id) > 1024:
+            return web.json_response({"ok": False}, status=400)
+        try:
+            async with asyncio.timeout(3), self.async_session_factory() as session:
+                payment = await payment_dal.get_payment_by_provider_payment_id(
+                    session, "platega", transaction_id
+                )
+                found = payment is not None
+        except Exception:
+            # Never expose DB exceptions, identifiers or merchant headers.
+            return web.json_response({"ok": False}, status=503)
+        return web.json_response({"ok": True, "found": found})
+
     async def webhook_route(self, request: web.Request) -> web.Response:
