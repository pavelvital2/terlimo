@@ -0,0 +1,175 @@
+"""No live bot/DB: execute public middleware, signed file rotation and page copy UI."""
+
+import json
+import os
+from html import unescape
+from pathlib import Path
+
+import pytest
+from aiogram.types import CallbackQuery, Message, Update
+from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
+
+from bot.app.web.recovery_page import recovery_page_response
+from bot.middlewares.public_recovery import PublicRecoveryMiddleware
+from bot.services.public_recovery import public_recovery_code, recovery_texts
+from bot.services.recovery_code import sign_seed
+
+ROOT = Path(__file__).resolve().parents[2]
+VECTOR = json.loads((ROOT / "tests/fixtures/recovery-v1-test-vector.json").read_text())
+KEY = Ed25519PrivateKey.from_private_bytes(bytes.fromhex(VECTOR["private_test_seed_hex"]))
+
+
+class Translator:
+    def __init__(self):
+        self.locales = {
+            lang: json.loads((ROOT / "locales" / f"{lang}.json").read_text())
+            for lang in ["ru", "en"]
+        }
+
+    def gettext(self, lang_code, key, **kwargs):
+        return self.locales[lang_code or "ru"][key]
+
+
+@pytest.fixture
+def configured(tmp_path, monkeypatch):
+    file = tmp_path / "code"
+    file.write_text(VECTOR["recovery_code"])
+    monkeypatch.setenv("RECOVERY_CODE_FILE", str(file))
+    monkeypatch.setenv("RECOVERY_VERIFY_KEY_B64", VECTOR["public_key_b64"])
+    monkeypatch.setenv("TERLIMO_RECOVERY_ENVIRONMENT", "test")
+    public_recovery_code.cache_clear()
+    yield file
+    public_recovery_code.cache_clear()
+
+
+def update(text):
+    return Update.model_validate(
+        {
+            "update_id": 1,
+            "message": {
+                "message_id": 2,
+                "date": 1,
+                "chat": {"id": 123, "type": "private"},
+                "from": {"id": 123, "is_bot": False, "first_name": "TEST", "language_code": "ru"},
+                "text": text,
+            },
+        }
+    )
+
+
+@pytest.mark.asyncio
+async def test_public_actions_before_account_chain_and_new_file(configured, monkeypatch):
+    sent = []
+
+    async def answer(self, text, **kwargs):
+        sent.append((text, kwargs))
+
+    monkeypatch.setattr(Message, "answer", answer)
+
+    async def forbidden(*args):
+        raise AssertionError("DB/profile/registration/account chain must not run")
+
+    middleware = PublicRecoveryMiddleware(Translator())
+    for text in ["/start recovery", "/recovery"]:
+        await middleware(forbidden, update(text), {})
+    assert unescape(sent[0][0]) == "<pre>" + VECTOR["recovery_code"] + "</pre>"
+    assert sent[0][1]["parse_mode"] == "HTML" and "Скопируйте" in sent[1][0]
+    seed = dict(VECTOR["seed"], revision="43", peer_ip="192.0.2.124", vk_hashes=["new-test-hash"])
+    newer = sign_seed(json.dumps(seed).encode(), KEY, "test")
+    replacement = configured.with_suffix(".new")
+    replacement.write_text(newer)
+    os.replace(replacement, configured)
+    await middleware(forbidden, update("/start recovery"), {})
+    assert newer in sent[-2][0] and VECTOR["recovery_code"] not in sent[-2][0]
+    configured.unlink()
+    await middleware(forbidden, update("/recovery"), {})
+    assert "недоступен" in sent[-1][0] and "TR1." not in sent[-1][0]
+
+
+@pytest.mark.asyncio
+async def test_menu_callback_and_unchanged_registration_chain(configured, monkeypatch):
+    sent = []
+    ack = []
+    other = []
+
+    async def answer(self, text, **kwargs):
+        sent.append(text)
+
+    async def callback_answer(self, **kwargs):
+        ack.append(True)
+
+    monkeypatch.setattr(Message, "answer", answer)
+    monkeypatch.setattr(CallbackQuery, "answer", callback_answer)
+
+    async def ordinary(event, data):
+        other.append(event)
+        return "ordinary"
+
+    middleware = PublicRecoveryMiddleware(Translator())
+    original = update("/start other-token")
+    assert await middleware(ordinary, original, {}) == "ordinary" and other == [original]
+    message = update("").message
+    callback = Update.model_validate(
+        {
+            "update_id": 3,
+            "callback_query": {
+                "id": "TEST",
+                "from": {"id": 123, "is_bot": False, "first_name": "TEST", "language_code": "ru"},
+                "chat_instance": "TEST",
+                "data": "public_recovery",
+                "message": message.model_dump(),
+            },
+        }
+    )
+    await middleware(ordinary, callback, {})
+    assert len(ack) == 1 and len(sent) == 2 and len(other) == 1
+    # Unrelated/group messages stay on the existing chain.
+    group_data = update("/recovery").model_dump()
+    group_data["message"]["chat"]["type"] = "group"
+    group = Update.model_validate(group_data)
+    assert await middleware(ordinary, group, {}) == "ordinary"
+
+
+def test_page_public_localized_valid_missing_and_environment_guard(configured, monkeypatch):
+    for lang in ["ru", "en"]:
+        response = recovery_page_response(
+            public_recovery_code(), recovery_texts(Translator(), lang), language=lang
+        )
+        assert response.status == 200 and VECTOR["recovery_code"] in response.text
+        assert 'id="copy-code"' in response.text and "readonly" in response.text
+        assert (
+            response.headers["Cache-Control"] == "no-store" and "Set-Cookie" not in response.headers
+        )
+    # Default production reader never issues a TEST code on a production site.
+    monkeypatch.delenv("TERLIMO_RECOVERY_ENVIRONMENT")
+    public_recovery_code.cache_clear()
+    response = recovery_page_response(public_recovery_code(), recovery_texts(Translator(), "ru"))
+    assert response.status == 503 and VECTOR["recovery_code"] not in response.text
+    assert 'id="copy-code"' not in response.text
+
+
+@pytest.mark.asyncio
+async def test_real_dispatcher_public_recovery_does_not_open_fsm_storage(configured, monkeypatch):
+    from aiogram import Bot, Dispatcher
+    from aiogram.fsm.storage.memory import MemoryStorage
+
+    class UnavailableAccountStorage(MemoryStorage):
+        async def get_state(self, key):
+            raise AssertionError("Account FSM/Redis must not run for public recovery")
+
+    sent = []
+
+    async def answer(self, text, **kwargs):
+        sent.append(text)
+
+    monkeypatch.setattr(Message, "answer", answer)
+    dp = Dispatcher(storage=UnavailableAccountStorage())
+    dp.update.outer_middleware.unregister(dp.fsm)
+    dp.update.outer_middleware(PublicRecoveryMiddleware(Translator()))
+    dp.update.outer_middleware(dp.fsm)
+    bot = Bot("123456:TEST-not-real-token")
+    try:
+        await dp.feed_update(bot, update("/start recovery"))
+        assert len(sent) == 2 and VECTOR["recovery_code"] in sent[0]
+    finally:
+        await bot.session.close()
