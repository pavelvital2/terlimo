+"""Anonymous recovery page on the existing site, independent of auth and DB."""
+
+from aiohttp import web
+
+from bot.services.public_recovery import public_recovery_code, recovery_texts
+
+from .context import get_i18n
+from .recovery_page import recovery_page_response
+
+
+async def public_recovery_page_route(request: web.Request) -> web.Response:
+    i18n = get_i18n(request)
+    if i18n is None:
+        raise web.HTTPServiceUnavailable(headers={"Cache-Control": "no-store"})
