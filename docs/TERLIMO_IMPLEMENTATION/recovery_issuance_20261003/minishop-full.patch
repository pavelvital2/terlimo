diff --git a/backend/bot/middlewares/public_recovery.py b/backend/bot/middlewares/public_recovery.py
new file mode 100644
index 00000000..7f765979
--- /dev/null
+++ b/backend/bot/middlewares/public_recovery.py
@@ -0,0 +1,67 @@
+"""Exact public recovery actions before DB/profile/registration middleware.
+
+The existing private-chat bot handles these nonpersonal transport codes without
+creating users, requiring membership, grants or contacting an old backend.
+All other updates follow the unchanged authenticated/account middleware chain.
+"""
+
+from collections.abc import Awaitable, Callable
+from html import escape
+from typing import Any
+
+from aiogram import BaseMiddleware
+from aiogram.types import Message, TelegramObject, Update
+
+from bot.services.public_recovery import Translator, public_recovery_code
+from bot.services.recovery_code import RecoveryUnavailable
+
+
+class PublicRecoveryMiddleware(BaseMiddleware):
+    def __init__(self, i18n: Translator, username: str = "") -> None:
+        self.i18n = i18n
+        self.username = username.lstrip("@")
+        self.loader = public_recovery_code()
+
+    async def __call__(
+        self,
+        handler: Callable[[TelegramObject, dict[str, Any]], Awaitable[Any]],
+        event: TelegramObject,
+        data: dict[str, Any],
+    ) -> Any:
+        if not isinstance(event, Update):
+            return await handler(event, data)
+        message = event.message
+        callback = event.callback_query
+        texts = {"/recovery", "/start recovery"}
+        if self.username:
+            texts |= {"/recovery@" + self.username, "/start@" + self.username + " recovery"}
+        matched = (
+            message is not None
+            and message.chat.type == "private"
+            and (message.text or "").strip() in texts
+        )
+        if callback is not None and callback.data == "public_recovery":
+            # InaccessibleMessage cannot send replies; do not run account actions.
+            if not isinstance(callback.message, Message):
+                await callback.answer()
+                return None
+            if callback.message.chat.type != "private":
+                return await handler(event, data)
+            message = callback.message
+            matched = True
+        if not matched or message is None:
+            return await handler(event, data)
+        user = (
+            event.message.from_user if event.message else callback.from_user if callback else None
+        )
+        lang = "ru" if user and (user.language_code or "").startswith("ru") else "en"
+        if callback:
+            await callback.answer()
+        try:
+            code = self.loader.get()
+        except RecoveryUnavailable:
+            await message.answer(self.i18n.gettext(lang, "recovery_unavailable"), parse_mode=None)
+            return None
+        await message.answer("<pre>" + escape(code) + "</pre>", parse_mode="HTML")
+        await message.answer(self.i18n.gettext(lang, "recovery_bot_instruction"), parse_mode=None)
+        return None
