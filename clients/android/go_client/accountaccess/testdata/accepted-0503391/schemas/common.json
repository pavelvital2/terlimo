{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terlimo.local/schemas/common.json",
  "title": "TERLIMO mobile v1 common definitions",
  "$defs": {
    "SchemaVersion": {
      "type": "string",
      "const": "1.0",
      "description": "Target contract revision. Breaking changes require a new value and whitelist freeze."
    },
    "RequestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "description": "128-bit random id, lowercase hex, unique per logical request."
    },
    "Revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Monotonic decimal integer as a string; never a JSON float."
    },
    "Generation": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "description": "Fence/generation decimal integer as a string."
    },
    "UtcTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "description": "RFC3339 UTC instant, always Z, seconds precision or finer."
    },
    "Base64UrlNoPad": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "base64url without padding."
    },
    "Hex256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "OpaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ServerFields": {
      "type": "object",
      "properties": {
        "request_id": { "$ref": "#/$defs/RequestId" },
        "server_time": { "$ref": "#/$defs/UtcTime" },
        "schema_version": { "$ref": "#/$defs/SchemaVersion" }
      },
      "required": ["request_id", "server_time", "schema_version"],
      "additionalProperties": true,
      "description": "Mandatory fields present in every mobile v1 response."
    },
    "IdempotencyKey": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "description": "Client-generated key for mutating operations; scoped to account+installation+operation and bound to the request digest."
    },
    "Money": {
      "type": "object",
      "properties": {
        "amount_minor": { "type": "integer", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      },
      "required": ["amount_minor", "currency"],
      "additionalProperties": false,
      "description": "Exact integer minor units; no floating point money."
    },
    "Page": {
      "type": "object",
      "properties": {
        "cursor": { "type": ["string", "null"], "maxLength": 512 },
        "has_more": { "type": "boolean" }
      },
      "required": ["has_more"],
      "additionalProperties": false
    }
  }
}
